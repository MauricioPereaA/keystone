// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PR pipeline generator > matches the serialized YAML snapshot 1`] = `
"# GENERATED by @keystone/platform — do not edit by hand.
# Regenerate: pnpm --filter @keystone/platform generate:workflows
# Every deploy job emits the DoraEvent telemetry step; that is what keeps DORA
# metrics comparable across teams (ADR-0002). Change the generator, not the YAML.

name: PR Pipeline
on:
  pull_request:
    types:
      - opened
      - synchronize
      - reopened
jobs:
  small-tests:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    outputs:
      work_id: \${{ steps.standards.outputs.work_id }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Set up uv
        uses: astral-sh/setup-uv@v6
      - name: Validate conventions & resolve Work ID (devex)
        id: standards
        run: |-
          set -euo pipefail
          uvx --from "git+https://github.com/MauricioPereaA/keystone#subdirectory=packages/devex-cli" devex standards-check
          echo "work_id=$(uvx --from "git+https://github.com/MauricioPereaA/keystone#subdirectory=packages/devex-cli" devex workid)" >> "$GITHUB_OUTPUT"
      - name: Install dependencies
        run: |-
          set -euo pipefail
          if [ -f pyproject.toml ]; then
            uv sync --extra dev
          else
            uv venv
            # uv pip install auto-targets the .venv just created — no activation needed (uv != pip).
            deps_found=""
            for req in requirements.txt requirements-dev.txt; do
              if [ -f "$req" ]; then
                uv pip install -r "$req"
                deps_found=1
              fi
            done
            if [ -z "$deps_found" ]; then
              echo "::error::no pyproject.toml, requirements.txt or requirements-dev.txt at the repo root — the python toolchain has nothing to install"
              exit 1
            fi
          fi
      - name: Unit + property-based tests
        run: uv run --no-project pytest -q
      - name: "API contract: validate OpenAPI schema"
        run: |-
          set -euo pipefail
          spec=""
          for candidate in openapi.yaml openapi.yml openapi.json; do
            if [ -f "$candidate" ]; then
              spec="$candidate"
              break
            fi
          done
          if [ -z "$spec" ]; then
            echo "::error::no OpenAPI spec found (openapi.yaml, openapi.yml, openapi.json) — add one at the repo root or set apiSpec in keystone.json"
            exit 1
          fi
          uvx --from openapi-spec-validator openapi-spec-validator "$spec"
  deploy-sandbox:
    runs-on: ubuntu-latest
    environment: sandbox
    permissions:
      id-token: write
      contents: read
    needs:
      - small-tests
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Set up pnpm
        uses: pnpm/action-setup@v4
      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: "24"
          cache: pnpm
      - name: Install infra dependencies
        run: pnpm install --frozen-lockfile
      - name: Configure AWS credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: \${{ vars.AWS_DEPLOY_ROLE_ARN }}
          aws-region: \${{ vars.AWS_REGION }}
      - name: Emit DORA telemetry (deployment.started)
        run: |-
          set -euo pipefail
          jq -nc \\
            --arg schemaVersion "1.0.0" \\
            --arg event "deployment.started" \\
            --arg workId "\${{ needs.small-tests.outputs.work_id }}" \\
            --arg actor "\${{ github.actor }}" \\
            --arg repo "\${{ github.repository }}" \\
            --arg env "sandbox" \\
            --arg commitSha "\${{ github.sha }}" \\
            --arg commitTime "\${{ github.event.head_commit.timestamp || github.event.pull_request.updated_at }}" \\
            --arg timestamp "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \\
            --arg runId "\${{ github.run_id }}" \\
            '{schemaVersion:$schemaVersion,event:$event,workId:$workId,actor:$actor,repo:$repo,env:$env,commitSha:$commitSha,commitTime:$commitTime,timestamp:$timestamp,runId:$runId}' \\
            | tee -a "$GITHUB_STEP_SUMMARY"
      - name: Deploy to sandbox (CDK)
        id: deploy
        run: pnpm exec cdk deploy --all --require-approval never --context env=sandbox
      - name: Emit DORA telemetry (deployment.succeeded)
        if: success()
        run: |-
          set -euo pipefail
          jq -nc \\
            --arg schemaVersion "1.0.0" \\
            --arg event "deployment.succeeded" \\
            --arg workId "\${{ needs.small-tests.outputs.work_id }}" \\
            --arg actor "\${{ github.actor }}" \\
            --arg repo "\${{ github.repository }}" \\
            --arg env "sandbox" \\
            --arg commitSha "\${{ github.sha }}" \\
            --arg commitTime "\${{ github.event.head_commit.timestamp || github.event.pull_request.updated_at }}" \\
            --arg timestamp "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \\
            --arg runId "\${{ github.run_id }}" \\
            '{schemaVersion:$schemaVersion,event:$event,workId:$workId,actor:$actor,repo:$repo,env:$env,commitSha:$commitSha,commitTime:$commitTime,timestamp:$timestamp,runId:$runId}' \\
            | tee -a "$GITHUB_STEP_SUMMARY"
      - name: Emit DORA telemetry (deployment.failed)
        if: failure()
        run: |-
          set -euo pipefail
          jq -nc \\
            --arg schemaVersion "1.0.0" \\
            --arg event "deployment.failed" \\
            --arg workId "\${{ needs.small-tests.outputs.work_id }}" \\
            --arg actor "\${{ github.actor }}" \\
            --arg repo "\${{ github.repository }}" \\
            --arg env "sandbox" \\
            --arg commitSha "\${{ github.sha }}" \\
            --arg commitTime "\${{ github.event.head_commit.timestamp || github.event.pull_request.updated_at }}" \\
            --arg timestamp "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \\
            --arg runId "\${{ github.run_id }}" \\
            '{schemaVersion:$schemaVersion,event:$event,workId:$workId,actor:$actor,repo:$repo,env:$env,commitSha:$commitSha,commitTime:$commitTime,timestamp:$timestamp,runId:$runId}' \\
            | tee -a "$GITHUB_STEP_SUMMARY"
"
`;
