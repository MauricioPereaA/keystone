# Local dev .env — copy to .env (gitignored) and fill in real values.
# Keystone holds almost no runtime secrets by design: deploys use GitHub OIDC,
# not stored AWS keys. Production values come from AWS Secrets Manager, never here.
#
# Each variable must also be read through a single entrypoint per package
# (see docs/engineering-rules/environment-variables.md), never scattered os.environ/process.env.

# ──────────────────────────────────────────────────────────────
# AWS (used by @keystone/platform CDK + generated deploy workflows)
# ──────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# OIDC deploy role ARN (a Variable, not a secret — see docs/runbooks/github-aws-oidc.md)
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::000000000000:role/keystone-gh-deployer

# ──────────────────────────────────────────────────────────────
# Telemetry (DORA / audit event collector — PoC)
# ──────────────────────────────────────────────────────────────
# Path to the NDJSON DoraEvent stream that `devex dora` reads (local/CI). Active.
KEYSTONE_TELEMETRY_STREAM=./telemetry.ndjson
# Reserved for the production collector — NOT yet read by code (the PoC emits to
# stdout + the GitHub Actions step summary). Where deploy workflows will ship it:
# KEYSTONE_TELEMETRY_SINK=cloudwatch        # cloudwatch | s3 | stdout
# KEYSTONE_TELEMETRY_LOG_GROUP=/keystone/dora

# ──────────────────────────────────────────────────────────────
# Framework generator (@keystone/platform — optional overrides)
# ──────────────────────────────────────────────────────────────
# Target repo + language for `pnpm generate:workflows` (defaults shown).
# KEYSTONE_REPO=MauricioPereaA/keystone
# KEYSTONE_LANGUAGE=python

# ──────────────────────────────────────────────────────────────
# devex CLI (optional overrides; sensible defaults otherwise)
# ──────────────────────────────────────────────────────────────
# Path override for the conventions file (defaults to the bundled copy).
# KEYSTONE_CONVENTIONS_PATH=conventions/conventions.json
