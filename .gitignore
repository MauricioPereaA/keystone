# ── Secrets / env ────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python (packages/devex-cli) ──────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
sdist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
htmlcov/

# ── Node / pnpm (packages/platform-framework) ────────────────────
node_modules/
.pnpm-store/
.vite/
*.tsbuildinfo

# The framework SHIPS its compiled output: it is distributed over Git with no
# registry to host a built tarball, so `dist/` is committed and kept in sync by a
# CI gate (ADR-0004). This re-includes it despite the global `dist/` ignore above.
!/packages/platform-framework/dist/
!/packages/platform-framework/dist/**

# ── AWS CDK ──────────────────────────────────────────────────────
cdk.out/
*.cdk.staging/

# ── Local dev env (LocalStack offline demo) ──────────────────────
.localstack/
telemetry.ndjson

# ── OS / editor ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ── Logs / scratch ───────────────────────────────────────────────
*.log
.scratch/
*.local
*.private

# ── Local AI-assistant tooling (on-disk only, not part of the deliverable) ──
/CLAUDE.md
/.claude/
